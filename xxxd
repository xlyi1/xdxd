local function openMenu()
    if menuOpen then return end
    menuOpen = true
    previousMouseBehavior = UserInputService.MouseBehavior
    previousMouseIconEnabled = UserInputService.MouseIconEnabled
    ScreenGui.Enabled = true
    Main.Visible = true
    Main.Position = UDim2.fromScale(0.5, 0.5)
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
    if cursorConnection then cursorConnection:Disconnect() end
    cursorConnection = RunService.RenderStepped:Connect(function()
        if menuOpen then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
            if not ScreenGui.Enabled then ScreenGui.Enabled = true end
            if not Main.Visible then Main.Visible = true end
        end
    end)
end

local function closeMenu()
    if not menuOpen then return end
    menuOpen = false
    aimHeld = false
    currentTarget = nil
    Main.Visible = false
    if cursorConnection then
        cursorConnection:Disconnect()
        cursorConnection = nil
    end
    if previousMouseBehavior ~= nil then
        UserInputService.MouseBehavior = previousMouseBehavior
    end
    if previousMouseIconEnabled ~= nil then
        UserInputService.MouseIconEnabled = previousMouseIconEnabled
    end
    previousMouseBehavior = nil
    previousMouseIconEnabled = nil
end

local function toggleMenu()
    if menuOpen then closeMenu() else openMenu() end
end

