local ESPFrames = {}

local function createESPFrame(player)
    if player == LocalPlayer then return end
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(100, 200)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = Camera
    
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 1, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 2
    box.BorderColor3 = player.Team == LocalPlayer.Team and Settings.ESPTeamColor or Settings.ESPColor
    box.Parent = frame
    
    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.fromOffset(4, 200)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.Position = UDim2.fromOffset(-6, 0)
    healthBar.Parent = frame
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Colors.Text
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Position = UDim2.fromOffset(0, -20)
    nameLabel.Parent = frame
    
    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Size = UDim2.new(1, 0, 0, 20)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.TextColor3 = Colors.Text
    distanceLabel.TextSize = 12
    distanceLabel.Font = Enum.Font.Gotham
    distanceLabel.Position = UDim2.new(0, 0, 1, 0)
    distanceLabel.Parent = frame
    
    ESPFrames[player] = {
        Frame = frame,
        Box = box,
        HealthBar = healthBar,
        Name = nameLabel,
        Distance = distanceLabel,
    }
end

local function updateESP(player, data)
    local character = player.Character
    if not character then
        data.Frame.Visible = false
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    
    if not humanoid or humanoid.Health <= 0 or not root or not head then
        data.Frame.Visible = false
        return
    end
    
    if Settings.TeamCheck and player.Team == LocalPlayer.Team then
        data.Frame.Visible = false
        return
    end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local footPos, footOnScreen = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
    
    if not onScreen or not headOnScreen or not footOnScreen then
        data.Frame.Visible = false
        return
    end
    
    local height = math.abs(footPos.Y - headPos.Y)
    local width = height * 0.6
    
    data.Frame.Position = UDim2.fromOffset(screenPos.X - width/2, headPos.Y)
    data.Frame.Size = UDim2.fromOffset(width, height)
    data.Frame.Visible = Settings.ESP and Settings.ESPBox
    data.Box.BorderColor3 = player.Team == LocalPlayer.Team and Settings.ESPTeamColor or Settings.ESPColor
    
    if Settings.ESPHealth then
        local healthRatio = humanoid.Health / humanoid.MaxHealth
        data.HealthBar.Size = UDim2.fromOffset(4, height * healthRatio)
        data.HealthBar.BackgroundColor3 = Color3.fromRGB(
            math.floor(255 * (1 - healthRatio)),
            math.floor(255 * healthRatio),
            0
        )
        data.HealthBar.Visible = true
    else
        data.HealthBar.Visible = false
    end
    
    data.Name.Visible = Settings.ESPName
    data.Name.Text = player.Name
    
    if Settings.ESPDistance and LocalPlayer.Character then
        local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if localRoot then
            local distance = math.floor((root.Position - localRoot.Position).Magnitude)
            data.Distance.Text = distance .. " studs"
            data.Distance.Visible = true
        end
    else
        data.Distance.Visible = false
    end
end

