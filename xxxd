-- Activates the selected tab, hides inactive pages, and animates the active-tab indicator.
local tabPageTweens = {}
local indicatorTween = nil
local function selectTab(index)
    if not Pages[index] then return end
    local previousTab = activeTab
    local direction = (index >= previousTab) and 1 or -1
    activeTab = index

    for i, button in ipairs(TabButtons) do
        button.TextColor3 = (i == index) and Colors.Accent or Colors.Muted
        local page = Pages[i]
        if tabPageTweens[i] then
            tabPageTweens[i]:Cancel()
            tabPageTweens[i] = nil
        end

        if i == index then
            page.Visible = true
            if Settings.SmoothTabs and previousTab ~= index then
                page.Position = UDim2.fromOffset(direction * 18, 0)
                local pageTween = TweenService:Create(
                    page,
                    TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                    {Position = UDim2.fromOffset(0, 0)}
                )
                tabPageTweens[i] = pageTween
                pageTween:Play()
            else
                page.Position = UDim2.fromOffset(0, 0)
            end
        else
            page.Visible = false
            page.Position = UDim2.fromOffset(0, 0)
        end
    end

    local target = UDim2.new((index - 1) / #TabNames, 8, 1, -3)
    if indicatorTween then
        indicatorTween:Cancel()
        indicatorTween = nil
    end
    if Settings.SmoothTabs then
        indicatorTween = TweenService:Create(
            TabIndicator,
            TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Position = target}
        )
        indicatorTween:Play()
    else
        TabIndicator.Position = target
    end
end

for i, button in ipairs(TabButtons) do
    button.MouseButton1Click:Connect(function()
        selectTab(i)
    end)
end

-- Smoothly scrolls the currently visible page when the mouse wheel is used over it.
-- Native ScrollingFrame input is disabled above so wheel movement is handled by one eased tween.
local pageScrollTweens = {}
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end

    local mousePosition = UserInputService:GetMouseLocation()
    for _, page in ipairs(Pages) do
        if page.Visible then
            local pagePosition = page.AbsolutePosition
            local pageSize = page.AbsoluteSize
            local insidePage = mousePosition.X >= pagePosition.X
                and mousePosition.X <= pagePosition.X + pageSize.X
                and mousePosition.Y >= pagePosition.Y
                and mousePosition.Y <= pagePosition.Y + pageSize.Y

            if insidePage then
                local maximumScroll = math.max(0, page.CanvasSize.Y.Offset - page.AbsoluteSize.Y)
                local targetY = math.clamp(page.CanvasPosition.Y - (input.Position.Z * 92), 0, maximumScroll)

                if pageScrollTweens[page] then
                    pageScrollTweens[page]:Cancel()
                end

                local scrollTween = TweenService:Create(
                    page,
                    TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                    {CanvasPosition = Vector2.new(0, targetY)}
                )
                pageScrollTweens[page] = scrollTween
                scrollTween:Play()
                break
            end
        end
    end
end)

