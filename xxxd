local function getModelParts(model)
    if not model or not model:IsA("Model") then return nil, nil, nil end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    local head = model:FindFirstChild("Head") or root
    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return humanoid, nil, head
    end
    if not head or not head:IsA("BasePart") then head = root end
    return humanoid, root, head
end

