local menuVisible = false
local menuTween = nil
local MENU_SIZE = UDim2.new(0, 600, 0, 400)

local function setMenuVisible(visible)
    if menuVisible == visible then
        return
    end

    menuVisible = visible

    if menuTween then
        menuTween:Cancel()
        menuTween = nil
    end

    if visible then
        MainFrame.Visible = true
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default

        local currentCamera = workspace.CurrentCamera
        if currentCamera then
            pcall(function()
                GuiService:SetCursorPosition(Vector2.new(
                    currentCamera.ViewportSize.X / 2,
                    currentCamera.ViewportSize.Y / 2
                ))
            end)
        end

        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.BackgroundTransparency = 1
        menuTween = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Size = MENU_SIZE, BackgroundTransparency = 0}
        )
        menuTween:Play()
    else
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        local closingTween = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}
        )
        menuTween = closingTween
        closingTween.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed
                and not menuVisible
                and menuTween == closingTween then
                MainFrame.Visible = false
            end
        end)
        closingTween:Play()
    end
end

local function toggleMenu()
    setMenuVisible(not menuVisible)
end

