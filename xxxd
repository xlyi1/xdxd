-- Places the information overlay in the selected screen corner.
local function updateOverlayPosition()
    local position = Settings.OverlayPosition
    if position == "TopRight" then
        Overlay.AnchorPoint = Vector2.new(1, 0)
        Overlay.Position = UDim2.new(1, -12, 0, 12)
    elseif position == "BottomLeft" then
        Overlay.AnchorPoint = Vector2.new(0, 1)
        Overlay.Position = UDim2.new(0, 12, 1, -12)
    elseif position == "BottomRight" then
        Overlay.AnchorPoint = Vector2.new(1, 1)
        Overlay.Position = UDim2.new(1, -12, 1, -12)
    else
        Overlay.AnchorPoint = Vector2.new(0, 0)
        Overlay.Position = UDim2.fromOffset(12, 12)
    end
end

-- Builds the watermark/FPS/clock text and adjusts the overlay width to fit its contents.
local function updateOverlay(fps)
    local parts = {}
    if Settings.ShowWatermark then table.insert(parts, "vanta.lol") end
    if Settings.ShowFPS then table.insert(parts, tostring(fps or 0) .. " FPS") end
    if Settings.ShowClock then table.insert(parts, os.date("%H:%M:%S")) end
    Overlay.Visible = (#parts > 0)
    Overlay.Text = "  " .. table.concat(parts, "   |   ")
    local width = math.clamp(40 + (#Overlay.Text * 7), 150, 360)
    Overlay.Size = UDim2.fromOffset(width, 28)
    updateOverlayPosition()
end

