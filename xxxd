    button.TextColor3 = Colors.Text
    button.TextSize = 10
    button.AutoButtonColor = true
    button.Parent = row
    round(button, 6)

    local dropdownTranslations = {
        AccentTheme = {Cyan = "Cyjan", Purple = "Fiolet", Red = "Czerwony", Green = "Zielony", Orange = "Pomarańczowy"},
        OverlayPosition = {TopLeft = "Lewy górny", TopRight = "Prawy górny", BottomLeft = "Lewy dolny", BottomRight = "Prawy dolny"},
        AimbotPart = {Head = "Głowa", HumanoidRootPart = "RootPart", UpperTorso = "Klatka", Torso = "Tułów"},
    }
    local function refresh()
        local rawValue = tostring(Settings[settingKey])
        local translations = dropdownTranslations[settingKey]
        button.Text = (translations and translations[rawValue] or rawValue) .. "  ▾"
    end
    button.MouseButton1Click:Connect(function()
        local currentIndex = table.find(options, Settings[settingKey]) or 0
        Settings[settingKey] = options[(currentIndex % #options) + 1]
        refresh()
        if settingKey == "AccentTheme" then
            Colors.Accent = ThemeColors[Settings.AccentTheme] or ThemeColors.Cyan
            MainStroke.Color = Colors.Accent
            applyAccentTheme()
        elseif settingKey == "OverlayPosition" then
            updateOverlay(0)
        end
    end)
    refresh()
    registerRefresher(refresh)
    return row
end

