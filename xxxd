    if featureConnection then featureConnection:Disconnect() end
    if indicatorTween then indicatorTween:Cancel() end
    for _, tween in pairs(tabPageTweens) do
        pcall(function() tween:Cancel() end)
    end
    for _, tween in pairs(pageScrollTweens) do
        pcall(function() tween:Cancel() end)
    end
end)

