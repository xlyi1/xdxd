    local closest = nil
    local closestAngle = Settings.AimbotFOV
    
    local cameraCF = Camera.CFrame
    local cameraPos = cameraCF.Position
    local cameraDirection = cameraCF.LookVector
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local head = character:FindFirstChild("Head")
            local root = character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and head and root then
                -- Team check
                if Settings.TeamCheck and player.Team == LocalPlayer.Team then
                    continue
                end
                
                -- Visibility check
                if Settings.VisibleCheck then
                    local ray = Ray.new(cameraPos, head.Position - cameraPos)
                    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
                    if hit and not hit:IsDescendantOf(character) then
                        continue
                    end
                end
                
                -- 70x HITBOX NA GŁOWĘ
                local enlargedHeadPos = head.Position + Vector3.new(0, 0.5 * Settings.HitboxScale, 0)
                
                local toTarget = (enlargedHeadPos - cameraPos).Unit
                local angle = math.deg(math.acos(cameraDirection:Dot(toTarget)))
                
                if angle < closestAngle then
                    closestAngle = angle
                    closest = enlargedHeadPos
                end
            end
        end
    end
    
    return closest
end

