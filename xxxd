local function isTargetVisible(targetPart, character)
    if not Settings.VisibleCheck then return true end
    local camera = workspace.CurrentCamera
    if not camera then return false end
    local origin = camera.CFrame.Position
    local direction = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclusions = {camera}
    if LocalPlayer.Character then table.insert(exclusions, LocalPlayer.Character) end
    params.FilterDescendantsInstances = exclusions
    local result = workspace:Raycast(origin, direction, params)
    return result == nil or result.Instance:IsDescendantOf(character)
end

local function getTargetPart(character)
    local requested = character:FindFirstChild(Settings.AimbotPart)
    if requested and requested:IsA("BasePart") then return requested end
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then return head end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    return nil
end

local function updateSkeleton(overlay, character, camera)
    local bones = character:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
    for i, frame in ipairs(overlay.Bones) do
        local drawn = false
        local pair = bones[i]
        if pair then
            local partA = character:FindFirstChild(pair[1])
            local partB = character:FindFirstChild(pair[2])
            if partA and partB then
                local a = camera:WorldToViewportPoint(partA.Position)
                local b = camera:WorldToViewportPoint(partB.Position)
                if a.Z > 0 and b.Z > 0 then
                    setLine(frame, Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y), Settings.SkeletonColor, Settings.SkeletonThickness)
                    drawn = true
                end
            end
        end
        if not drawn then frame.Visible = false end
    end
end

local function updatePlayerOverlay(player, overlay, camera)
    local character = player.Character
    local localCharacter = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local head = character and (character:FindFirstChild("Head") or root)
    if not Settings.ESP or not character or not humanoid or humanoid.Health <= 0 or not root or not head then
        hideOverlay(overlay)
        return
    end

    local isTeammate = LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team
    if Settings.TeamCheck and isTeammate then
        hideOverlay(overlay)
        return
    end

    local rootScreen, rootOnScreen = camera:WorldToViewportPoint(root.Position)
    local topScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
    local bottomScreen = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
    if not rootOnScreen or rootScreen.Z <= 0 or topScreen.Z <= 0 or bottomScreen.Z <= 0 then
        hideOverlay(overlay)
        return
    end

    local color = isTeammate and Settings.ESPTeamColor or Settings.ESPColor
    local boxHeight = math.max(bottomScreen.Y - topScreen.Y, 18)
    local boxWidth = math.max(boxHeight * 0.55, 10)
    local boxX = rootScreen.X - boxWidth / 2
    local boxY = topScreen.Y
    local bottomY = boxY + boxHeight

    overlay.Box.Visible = Settings.ESPBox
    if Settings.ESPBox then
        overlay.Box.Position = UDim2.fromOffset(boxX, boxY)
        overlay.Box.Size = UDim2.fromOffset(boxWidth, boxHeight)
        overlay.Box.BackgroundColor3 = color
        overlay.Box.BackgroundTransparency = Settings.ESPBoxFill and Settings.BoxFillTransparency or 1
        overlay.BoxStroke.Color = color
    end

    -- Health bar
    local showHealth = Settings.ESPHealth
    overlay.HealthBG.Visible = showHealth
    overlay.HealthFill.Visible = showHealth
    if showHealth then
        local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        overlay.HealthBG.Position = UDim2.fromOffset(boxX - 7, boxY - 1)
        overlay.HealthBG.Size = UDim2.fromOffset(4, boxHeight + 2)
        overlay.HealthFill.Position = UDim2.fromOffset(boxX - 6, bottomY)
        overlay.HealthFill.Size = UDim2.fromOffset(2, math.max(boxHeight * ratio, 1))
        overlay.HealthFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(70, 255, 110), ratio)
    end

    overlay.Name.Visible = Settings.ESPName
    if Settings.ESPName then
        overlay.Name.Position = UDim2.fromOffset(rootScreen.X - 75, boxY - 19)
        overlay.Name.Text = player.Name
    end

    overlay.Distance.Visible = Settings.ESPDistance and localCharacter ~= nil
    if overlay.Distance.Visible then
        local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
        if localRoot then
            local distance = math.floor((root.Position - localRoot.Position).Magnitude + 0.5)
            overlay.Distance.Position = UDim2.fromOffset(rootScreen.X - 75, bottomY + 1)
            overlay.Distance.Text = tostring(distance) .. " studs"
        else
            overlay.Distance.Visible = false
        end
    end

    if Settings.ESPLines then
        local viewport = camera.ViewportSize
        setLine(overlay.Line, Vector2.new(viewport.X / 2, viewport.Y), Vector2.new(rootScreen.X, bottomY), color, 1.5)
    else
        overlay.Line.Visible = false
    end

    if Settings.ESPSkeleton then
        updateSkeleton(overlay, character, camera)
    else
        hideBones(overlay)
    end
end

local function updateHitboxVisual(player)
    local current = HitboxAdornments[player]
    if not Settings.Hitbox then
        if current then current:Destroy(); HitboxAdornments[player] = nil end
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        if current then current:Destroy(); HitboxAdornments[player] = nil end
        return
    end
    if Settings.TeamCheck and LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team then
        if current then current:Destroy(); HitboxAdornments[player] = nil end
        return
    end
    if not current or current.Adornee ~= root then
        if current then current:Destroy() end
        current = Instance.new("BoxHandleAdornment")
        current.Name = "VantaLolHitboxVisual"
        current.Adornee = root
        current.AlwaysOnTop = true
        current.ZIndex = 8
        current.Transparency = 0.55
        current.Color3 = Settings.ESPColor
        current.CFrame = CFrame.new()
        current.Parent = root
        HitboxAdornments[player] = current
    end
    local scale = 1 + ((Settings.HitboxSize - 1) * 0.1)
    current.Size = root.Size * scale
    current.Color3 = Settings.ESPColor
end

