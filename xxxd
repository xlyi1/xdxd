local function updateOverlay(fps)
    local accentHex = Colors.Accent:ToHex()
    local parts = {}
    if Settings.ShowWatermark then
        table.insert(parts, '<font color="#' .. accentHex .. '"><b>' .. Settings.WatermarkText .. '</b></font>')
    end
    if Settings.ShowUsername then table.insert(parts, LocalPlayer.Name) end
    if Settings.ShowFPS and fps then table.insert(parts, tostring(fps) .. " fps") end
    if Settings.ShowPing then
        local ok, ping = pcall(function() return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        if ok then table.insert(parts, tostring(ping) .. " ms") end
    end
    if Settings.ShowClock then table.insert(parts, os.date("%H:%M:%S")) end
    Overlay.Text = table.concat(parts, ' <font color="#55555f">|</font> ')
end

