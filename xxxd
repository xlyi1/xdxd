local OpacityTargets = {}
local function registerOpacityTarget(instance)
    table.insert(OpacityTargets, instance)
end

local function applyBackgroundOpacity()
    local opacity = math.clamp(tonumber(Settings.BackgroundOpacity) or 0, 0, 0.30)
    for index = #OpacityTargets, 1, -1 do
        local target = OpacityTargets[index]
        if target and target.Parent then
            target.BackgroundTransparency = opacity
        else
            table.remove(OpacityTargets, index)
        end
    end
end

