    if not overlay then return end
    overlay.Box.Visible = false
    overlay.Name.Visible = false
    overlay.Distance.Visible = false
    overlay.Line.Visible = false
    overlay.HealthBG.Visible = false
    overlay.HealthFill.Visible = false
    hideBones(overlay)
end

local function removePlayerOverlay(player)
    local overlay = PlayerOverlays[player]
    if overlay then
        for _, object in pairs(overlay) do
            if typeof(object) == "Instance" then
                pcall(function() object:Destroy() end)
            end
        end
        for _, bone in ipairs(overlay.Bones) do
            pcall(function() bone:Destroy() end)
        end
        PlayerOverlays[player] = nil
    end
    local adornment = HitboxAdornments[player]
    if adornment then
        pcall(function() adornment:Destroy() end)
        HitboxAdornments[player] = nil
    end
end

