local function updateESP(player, deltaTime)
    local espData = ESPFrames[player]
    if not espData then return end
    
    local character = player.Character
    if not character or not Settings.ESP or menuOpen then
        espData.Frame.Visible = false
        espData.Name.Visible = false
        espData.Distance.Visible = false
        espData.Line.Visible = false
        return
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then
        espData.Frame.Visible = false
        return
    end
    
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
    if not onScreen or screenPos.Z <= 0 then
        espData.Frame.Visible = false
        return
    end
    
    -- Obliczanie ramki ESP
    local size = math.clamp(400 / screenPos.Z, 20, 200)
    local pos = Vector2.new(screenPos.X, screenPos.Y)
    
    espData.Frame.Position = UDim2.fromOffset(pos.X - size/2, pos.Y - size)
    espData.Frame.Size = UDim2.fromOffset(size, size * 2)
    espData.Frame.Visible = Settings.ESPBox
    
    if isEnemy(player) then
        espData.Stroke.Color = Settings.ESPColor
    else
        espData.Stroke.Color = Settings.ESPTeamColor
    end
    
    -- Nazwa
    if Settings.ESPName then
        espData.Name.Visible = true
        espData.Name.Position = UDim2.fromOffset(pos.X - 95, pos.Y - size - 20)
        espData.Name.Text = player.Name
    else
        espData.Name.Visible = false
    end
    
    -- Dystans
    if Settings.ESPDistance then
        local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if localRoot then
            local distance = math.floor((root.Position - localRoot.Position).Magnitude + 0.5)
            espData.Distance.Visible = true
            espData.Distance.Position = UDim2.fromOffset(pos.X - 95, pos.Y + size + 2)
            espData.Distance.Text = tostring(distance) .. " studów"
        end
    else
        espData.Distance.Visible = false
    end
    
    -- Linie
    if Settings.ESPLines then
        local viewport = camera.ViewportSize
        local startPoint = Vector2.new(viewport.X * 0.5, viewport.Y - 2)
        local endPoint = Vector2.new(screenPos.X, screenPos.Y)
        
        local delta = endPoint - startPoint
        local length = delta.Magnitude
        
        if length > 2 then
            espData.Line.Visible = true
            espData.Line.Position = UDim2.fromOffset(
                (startPoint.X + endPoint.X) * 0.5,
                (startPoint.Y + endPoint.Y) * 0.5
            )
            espData.Line.Size = UDim2.fromOffset(length, 2)
            espData.Line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
            espData.Line.BackgroundColor3 = espData.Stroke.Color
        else
            espData.Line.Visible = false
        end
    else
        espData.Line.Visible = false
    end
end

-- Hitboxy - powiększanie hitboxów graczy (działa lokalnie)
local hitboxConnections = {}

local function applyHitbox(player)
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Zapisujemy oryginalny rozmiar
    if not player:GetAttribute("OriginalSize") then
        player:SetAttribute("OriginalSize", root.Size)
    end
    
    -- Powiększamy hitbox (tylko wizualnie i lokalnie)
    if Settings.Hitbox then
        local newSize = root.Size * Settings.HitboxSize
        root.Size = newSize
        
        -- Dodajemy BoxHandleAdornment dla wizualizacji
        local adornment = Instance.new("BoxHandleAdornment")
        adornment.Name = "HitboxVisual"
        adornment.Adornee = root
        adornment.Size = newSize
        adornment.Transparency = 0.3
        adornment.Color3 = isEnemy(player) and Settings.ESPColor or Settings.ESPTeamColor
        adornment.AlwaysOnTop = true
        adornment.Parent = root
        
        -- Usuwamy stary adornment jeśli istnieje
        for _, child in ipairs(root:GetChildren()) do
            if child.Name == "HitboxVisual" and child ~= adornment then
                child:Destroy()
            end
        end
    end
end

