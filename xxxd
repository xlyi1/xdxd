local function updateFeatures()
    local camera = workspace.CurrentCamera
    if not camera then return end
    Camera = camera

    local viewport = camera.ViewportSize
    aimCircle.Size = UDim2.fromOffset(Settings.AimbotFOV * 2, Settings.AimbotFOV * 2)
    aimCircle.Position = UDim2.fromOffset(viewport.X / 2, viewport.Y / 2)
    aimCircle.Visible = Settings.ShowFOV and Settings.Aimbot and not menuOpen

    if Settings.Aimbot and not menuOpen then
        local closestPart = nil
        local shortestDistance = Settings.AimbotFOV
        local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local part = getTargetPart(character)
                local sameTeam = LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team
                if humanoid and humanoid.Health > 0 and part and not (Settings.TeamCheck and sameTeam) then
                    local screen, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen and screen.Z > 0 and isTargetVisible(part, character) then
                        local screenDistance = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                        if screenDistance < shortestDistance then
                            shortestDistance = screenDistance
                            closestPart = part
                        end
                    end
                end
            end
        end
        if closestPart then
            local desired = CFrame.lookAt(camera.CFrame.Position, closestPart.Position)
            local alpha = math.clamp(Settings.AimbotSmoothness, 0.01, 1)
            camera.CFrame = camera.CFrame:Lerp(desired, alpha)
        end
    end

    for player, overlay in pairs(PlayerOverlays) do
        updatePlayerOverlay(player, overlay, camera)
        updateHitboxVisual(player)
    end
end

local featureConnection = RunService.RenderStepped:Connect(updateFeatures)

local fpsFrames = 0
local fpsElapsed = 0
local renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
    fpsFrames = fpsFrames + 1
    fpsElapsed = fpsElapsed + deltaTime
    if fpsElapsed >= 0.5 then
        local currentFPS = math.floor(fpsFrames / math.max(fpsElapsed, 0.001) + 0.5)
        fpsFrames = 0
        fpsElapsed = 0
        updateOverlay(currentFPS)
    end
end)

