local lastFPS = 0
local function updateOverlay(fps)
    if fps and fps > 0 then lastFPS = fps end
    local accentHex = Colors.Accent:ToHex()
    local separator = ' <font color="#55555f">|</font> '
    local parts = {}

    if Settings.ShowWatermark then
        local text = tostring(Settings.WatermarkText or "vanta.lol")
        text = text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
        table.insert(parts, '<font color="#' .. accentHex .. '"><b>' .. text .. '</b></font>')
    end
    if Settings.ShowUsername then table.insert(parts, LocalPlayer.Name) end
    if Settings.ShowFPS then table.insert(parts, tostring(lastFPS) .. " fps") end
    if Settings.ShowPing then table.insert(parts, tostring(getPing()) .. " ms") end
    if Settings.ShowClock then table.insert(parts, os.date("%H:%M:%S")) end

    Overlay.Visible = (#parts > 0)
    Overlay.Text = table.concat(parts, separator)
    updateOverlayPosition()
end

