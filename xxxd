local function createSlider(parent, title, description, settingKey, minValue, maxValue, step)
    local row = createRow(parent, title, description, 64)
    local valueLabel = makeLabel(row, "", UDim2.new(1, -165, 0, 7), UDim2.fromOffset(145, 16), 10, Colors.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right)

    local track = Instance.new("Frame")
    track.Position = UDim2.new(1, -165, 0, 40)
    track.Size = UDim2.fromOffset(145, 5)
    track.BackgroundColor3 = Colors.Track
    track.BorderSizePixel = 0
    track.Active = true
    track.Parent = row
    round(track, 3)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Colors.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(15, 15)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Colors.Text
    knob.BorderSizePixel = 0
    knob.Active = true
    knob.Parent = track
    round(knob, 8)

    local function refresh()
        local value = math.clamp(tonumber(Settings[settingKey]) or minValue, minValue, maxValue)
        local ratio = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = string.format("%.2f", value)
    end

    local function setFromX(mouseX)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local ratio = math.clamp((mouseX - track.AbsolutePosition.X) / width, 0, 1)
        local raw = minValue + ((maxValue - minValue) * ratio)
        local value = minValue + math.floor(((raw - minValue) / step) + 0.5) * step
        value = math.clamp(value, minValue, maxValue)
        Settings[settingKey] = value
        refresh()
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setFromX(input.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setFromX(input.Position.X)
        end
    end)
    refresh()
    return row
end

local function createDropdown(parent, title, description, settingKey, options)
    local row = createRow(parent, title, description, 58)
    local button = Instance.new("TextButton")
    button.Position = UDim2.new(1, -155, 0.5, -14)
    button.Size = UDim2.fromOffset(140, 28)
    button.BackgroundColor3 = Colors.PanelAlt
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamSemibold
    button.TextColor3 = Colors.Text
    button.TextSize = 10
    button.Parent = row
    round(button, 6)

    local function refresh()
        button.Text = tostring(Settings[settingKey]) .. "  ▾"
    end
    button.MouseButton1Click:Connect(function()
        local currentIndex = table.find(options, Settings[settingKey]) or 0
        Settings[settingKey] = options[(currentIndex % #options) + 1]
        refresh()
    end)
    refresh()
    return row
end

