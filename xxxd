local function serializeSettings()
    local output = {}
    for key, value in pairs(Settings) do
        if typeof(value) == "Color3" then
            output[key] = {
                __color3 = true,
                r = math.floor(value.R * 255 + 0.5),
                g = math.floor(value.G * 255 + 0.5),
                b = math.floor(value.B * 255 + 0.5),
            }
        else
            output[key] = value
        end
    end
    return output
end

local function applyLoadedSettings(saved)
    for key, defaultValue in pairs(Defaults) do
        local value = saved[key]
        if typeof(defaultValue) == "Color3" then
            if type(value) == "table" and value.__color3 == true then
                Settings[key] = Color3.fromRGB(
                    math.clamp(tonumber(value.r) or 255, 0, 255),
                    math.clamp(tonumber(value.g) or 255, 0, 255),
                    math.clamp(tonumber(value.b) or 255, 0, 255)
                )
            end
        elseif type(value) == type(defaultValue) then
            Settings[key] = value
        end
    end

    Settings.AimbotFOV = math.clamp(tonumber(Settings.AimbotFOV) or 180, 10, 360)
    Settings.AimbotSmoothness = math.clamp(tonumber(Settings.AimbotSmoothness) or 0.25, 0.05, 1)
    Settings.HitboxSize = math.clamp(tonumber(Settings.HitboxSize) or 3, 1, 6)
    if type(Settings.AimbotKey) ~= "string" or not Enum.KeyCode[Settings.AimbotKey] or Settings.AimbotKey == "RightShift" then Settings.AimbotKey = "Q" end
    Settings.UIScale = math.clamp(tonumber(Settings.UIScale) or 1, 0.80, 1.20)
    Settings.BackgroundOpacity = math.clamp(tonumber(Settings.BackgroundOpacity) or 0.00, 0, 0.30)

    local validThemes = {Cyan = true, Purple = true, Red = true, Green = true, Orange = true}
    if not validThemes[Settings.AccentTheme] then Settings.AccentTheme = "Cyan" end
    local validPositions = {TopLeft = true, TopRight = true, BottomLeft = true, BottomRight = true}
    if not validPositions[Settings.OverlayPosition] then Settings.OverlayPosition = "TopLeft" end
    local validParts = {Head = true, HumanoidRootPart = true, UpperTorso = true, Torso = true}
    if not validParts[Settings.AimbotPart] then Settings.AimbotPart = "Head" end
end

