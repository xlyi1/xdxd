local fpsFrames = 0
local fpsElapsed = 0

RunService.RenderStepped:Connect(function(deltaTime)
    -- AIMBOT (70x hitbox)
    if Settings.Aimbot then
        local target = getClosestTarget()
        if target then
            local cameraPos = Camera.CFrame.Position
            local desiredCFrame = CFrame.lookAt(cameraPos, target)
            Camera.CFrame = Camera.CFrame:Lerp(desiredCFrame, Settings.AimbotSmoothness)
        end
    end
    
    -- ESP
    if Settings.ESP then
        for player, data in pairs(ESPFrames) do
            updateESP(player, data)
        end
    end
    
    -- HITBOX VISUAL
    for player in pairs(Players:GetPlayers()) do
        updateHitboxVisual(player)
    end
    
    -- FPS
    fpsFrames = fpsFrames + 1
    fpsElapsed = fpsElapsed + deltaTime
    if fpsElapsed >= 0.5 then
        local fps = math.floor(fpsFrames / fpsElapsed)
        fpsFrames = 0
        fpsElapsed = 0
        updateOverlay(fps)
    end
end)

