local function safeDestroyPrevious(parent)
    if not parent then return end
    for _, name in ipairs({GUI_NAME, "VantaLolUI_v61"}) do
        local ok, oldGui = pcall(function() return parent:FindFirstChild(name) end)
        if ok and oldGui then pcall(function() oldGui:Destroy() end) end
    end
end

local function getPlayerGui()
    local ok, playerGui = pcall(function() return LocalPlayer:WaitForChild("PlayerGui", 5) end)
    if ok then return playerGui end
    return nil
end

