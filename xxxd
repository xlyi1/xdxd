local function createDropdown(parent, title, description, settingKey, options)
    local row = createRow(parent, title, description, 58)
    local button = Instance.new("TextButton")
    button.Position = UDim2.new(1, -155, 0.5, -14)
    button.Size = UDim2.fromOffset(140, 28)
    button.BackgroundColor3 = Colors.PanelAlt
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamSemibold
    button.TextColor3 = Colors.Text
    button.TextSize = 10
    button.AutoButtonColor = true
    button.Parent = row
    round(button, 6)

    local function refresh()
        button.Text = tostring(Settings[settingKey]) .. "  ▾"
    end
    button.MouseButton1Click:Connect(function()
        local currentIndex = table.find(options, Settings[settingKey]) or 0
        Settings[settingKey] = options[(currentIndex % #options) + 1]
        refresh()
        if settingKey == "AccentTheme" then
            Colors.Accent = ThemeColors[Settings.AccentTheme] or ThemeColors.Cyan
            MainStroke.Color = Colors.Accent
            applyAccentTheme()
        elseif settingKey == "OverlayPosition" then
            updateOverlay(0)
        end
    end)
    refresh()
    registerRefresher(refresh)
    return row
end

