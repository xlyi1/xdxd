local function createToggle(parent, title, description, settingKey)
    local row = createRow(parent, title, description, 58)
    local track = Instance.new("TextButton")
    track.Name = settingKey .. "Toggle"
    track.Position = UDim2.new(1, -67, 0.5, -13)
    track.Size = UDim2.fromOffset(52, 26)
    track.BackgroundColor3 = Settings[settingKey] and Colors.Accent or Colors.Off
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row
    round(track, 13)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(20, 20)
    knob.Position = Settings[settingKey] and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(250, 251, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track
    round(knob, 10)

    local function refresh()
        local enabled = Settings[settingKey]
        track.BackgroundColor3 = enabled and Colors.Accent or Colors.Off
        knob.Position = enabled and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    end
    track.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        refresh()
        updateOverlay(0)
    end)
    registerAccentUpdater(refresh)
    registerRefresher(refresh)
    return row
end

local draggingSlider = nil
UserInputService.InputChanged:Connect(function(input)
    if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        draggingSlider(input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = nil
    end
end)

local function createSlider(parent, title, description, settingKey, minValue, maxValue, step)
    local row = createRow(parent, title, description, 64)
    local valueLabel = makeLabel(row, "", UDim2.new(1, -165, 0, 7), UDim2.fromOffset(145, 16), 10, Colors.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    registerAccentUpdater(function() valueLabel.TextColor3 = Colors.Accent end)

    local track = Instance.new("Frame")
    track.Position = UDim2.new(0.60, 0, 0, 39)
    track.Size = UDim2.new(0.34, 0, 0, 5)
    track.BackgroundColor3 = Colors.Track
    track.BorderSizePixel = 0
    track.Active = true
    track.Parent = row
    round(track, 3)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Colors.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, 3)
    registerAccentUpdater(function() fill.BackgroundColor3 = Colors.Accent end)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(15, 15)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Colors.Text
    knob.BorderSizePixel = 0
    knob.Active = true
    knob.Parent = track
    round(knob, 8)

    local decimals = (step < 1) and 2 or 0
    local function refresh()
        local value = math.clamp(tonumber(Settings[settingKey]) or minValue, minValue, maxValue)
        local ratio = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = string.format("%." .. tostring(decimals) .. "f", value)
    end

    local function setFromX(mouseX)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local ratio = math.clamp((mouseX - track.AbsolutePosition.X) / width, 0, 1)
        local raw = minValue + ((maxValue - minValue) * ratio)
        local value = minValue + math.floor(((raw - minValue) / step) + 0.5) * step
        value = math.clamp(value, minValue, maxValue)
        Settings[settingKey] = tonumber(string.format("%." .. tostring(decimals) .. "f", value))
        refresh()
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setFromX(input.Position.X)
            draggingSlider = setFromX
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setFromX(input.Position.X)
            draggingSlider = setFromX
        end
    end)
    refresh()
    registerRefresher(refresh)
    return row
end

