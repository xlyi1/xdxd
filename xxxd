    stroke(swatch, Colors.Text, 1, 0.45)

    local function refresh()
        swatch.BackgroundColor3 = Settings[settingKey]
    end
    swatch.MouseButton1Click:Connect(function()
        local hue, saturation, value = Settings[settingKey]:ToHSV()
        Settings[settingKey] = Color3.fromHSV((hue + 0.11) % 1, math.max(saturation, 0.75), math.max(value, 0.85))
        refresh()
    end)
    registerRefresher(refresh)
    return row
end

-- Theme updater is defined after all accent-bound UI objects are registered.
applyAccentTheme = function()
    Colors.Accent = ThemeColors[Settings.AccentTheme] or ThemeColors.Cyan
    MainStroke.Color = Colors.Accent
    for _, updater in ipairs(AccentUpdaters) do
        pcall(updater)
    end
    for i, button in ipairs(TabButtons) do
        button.TextColor3 = (i == activeTab) and Colors.Accent or Colors.Muted
    end
end

