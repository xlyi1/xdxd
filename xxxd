-- Removes an older copy of the menu so repeated execution does not create duplicate windows.
local function safeDestroyPrevious(parent)
    if not parent then return end
    local ok, oldGui = pcall(function()
        return parent:FindFirstChild(GUI_NAME)
    end)
    if ok and oldGui then
        pcall(function() oldGui:Destroy() end)
    end
end

-- Retrieves the local player's PlayerGui as a fallback parent for the interface.
local function getPlayerGui()
    local ok, playerGui = pcall(function()
        return LocalPlayer:WaitForChild("PlayerGui", 5)
    end)
    if ok then return playerGui end
    return nil
end

-- Selects a GUI container using the same fallback order as the working UI diagnostic.
local GuiParent
local GuiParentName = "Unknown"

if type(gethui) == "function" then
    local ok, hiddenGui = pcall(gethui)
    if ok and hiddenGui then
        GuiParent = hiddenGui
        GuiParentName = "gethui()"
    end
end

if not GuiParent then
    local ok = pcall(function()
        local probe = Instance.new("Folder")
        probe.Name = "__VantaLolGuiProbe"
        probe.Parent = CoreGui
        probe:Destroy()
    end)
    if ok then
        GuiParent = CoreGui
        GuiParentName = "CoreGui"
    end
end

if not GuiParent then
    GuiParent = getPlayerGui()
    GuiParentName = "PlayerGui"
end

if not GuiParent then
    warn("[vanta.lol] Could not find a GUI parent.")
    return
end

safeDestroyPrevious(GuiParent)

