local function saveConfig()
    if type(writefile) ~= "function" then
        ConfigStatus.Text = "Config: brak writefile()"
        return
    end
    local data = {}
    for key, value in pairs(Settings) do
        if typeof(value) == "Color3" then
            data[key] = {r = value.R, g = value.G, b = value.B}
        else
            data[key] = value
        end
    end
    writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    ConfigStatus.Text = "Config: zapisano!"
end

local function loadConfig()
    if type(readfile) ~= "function" then
        ConfigStatus.Text = "Config: brak readfile()"
        return
    end
    local ok, result = pcall(function()
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        for key, value in pairs(data) do
            if typeof(value) == "table" and value.r then
                Settings[key] = Color3.new(value.r, value.g, value.b)
            else
                Settings[key] = value
            end
        end
    end)
    ConfigStatus.Text = ok and "Config: wczytano!" or "Config: błąd wczytywania"
end

