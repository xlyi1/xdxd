local ESPObjects = {}

local function isVisible(part)
    if not Settings.VisibleCheck then
        return true
    end

    local currentCamera = workspace.CurrentCamera
    if not currentCamera or not part or not part.Parent then
        return false
    end

    local origin = currentCamera.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, currentCamera}
    params.IgnoreWater = true

    local result = workspace:Raycast(origin, direction, params)
    return result == nil or result.Instance:IsDescendantOf(part.Parent)
end

local OriginalHitboxSizes = setmetatable({}, {__mode = "k"})

local function enlargeHitbox(character)
    if not character then
        return
    end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return
    end

    local originalSize = OriginalHitboxSizes[rootPart]
    if not originalSize then
        originalSize = rootPart.Size
        OriginalHitboxSizes[rootPart] = originalSize
    end

    if Settings.Hitbox then
        rootPart.Size = originalSize * (1 + (Settings.HitboxSize - 1) * 0.1)
    else
        rootPart.Size = originalSize
    end
end

local ESPByPlayer = {}

local function hideESP(esp)
    if not esp then
        return
    end
    esp.Box.Visible = false
    esp.Name.Visible = false
    esp.Distance.Visible = false
    esp.Line.Visible = false
end

local function createESP(player)
    if player == LocalPlayer then
        return nil
    end

    if ESPByPlayer[player] then
        return ESPByPlayer[player]
    end

    if not Drawing or type(Drawing.new) ~= "function" then
        warn("XENO: Drawing API niedostępne w tym środowisku.")
        return nil
    end

    local ok, esp = pcall(function()
        return {
            Box = Drawing.new("Square"),
            Name = Drawing.new("Text"),
            Distance = Drawing.new("Text"),
            Line = Drawing.new("Line"),
            Player = player
        }
    end)

    if not ok or not esp then
        warn("XENO: Nie udało się utworzyć obiektów ESP dla " .. player.Name)
        return nil
    end

    esp.Box.Thickness = 2
    esp.Box.Color = Settings.ESPColor
    esp.Box.Filled = false

    esp.Name.Size = 13
    esp.Name.Center = true
    esp.Name.Outline = true
    esp.Name.Color = Color3.fromRGB(255, 255, 255)

    esp.Distance.Size = 11
    esp.Distance.Center = true
    esp.Distance.Outline = true
    esp.Distance.Color = Color3.fromRGB(255, 255, 0)

    esp.Line.Thickness = 1
    esp.Line.Color = Settings.ESPColor

    ESPByPlayer[player] = esp
    table.insert(ESPObjects, esp)
    return esp
end

local function removeESP(player)
    local esp = ESPByPlayer[player]
    if not esp then
        return
    end

    hideESP(esp)
    for _, drawingObject in pairs({esp.Box, esp.Name, esp.Distance, esp.Line}) do
        pcall(function()
            drawingObject:Remove()
        end)
    end

    ESPByPlayer[player] = nil
    local index = table.find(ESPObjects, esp)
    if index then
        table.remove(ESPObjects, index)
    end
end

local function updateESP(esp)
    if not Settings.ESP then
        hideESP(esp)
        return
    end

    local currentCamera = workspace.CurrentCamera
    local player = esp.Player
    local character = player and player.Character
    if not currentCamera or not character then
        hideESP(esp)
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    if not humanoid or humanoid.Health <= 0 or not rootPart or not head then
        hideESP(esp)
        return
    end

    local color = Settings.ESPColor
    local sameTeam = player.Team ~= nil
        and LocalPlayer.Team ~= nil
        and player.Team == LocalPlayer.Team
    if sameTeam then
        if Settings.TeamCheck then
            hideESP(esp)
            return
        end
        color = Settings.ESPTeamColor
    end

    local headScreen, headOnScreen = currentCamera:WorldToViewportPoint(head.Position)
    local rootScreen, rootOnScreen = currentCamera:WorldToViewportPoint(rootPart.Position)
    if not headOnScreen or not rootOnScreen or headScreen.Z <= 0 or rootScreen.Z <= 0 then
        hideESP(esp)
        return
    end

    local boxHeight = math.max(8, math.abs(headScreen.Y - rootScreen.Y) * 2)
    local boxWidth = boxHeight * 0.6
    local boxPos = Vector2.new(rootScreen.X - boxWidth / 2, rootScreen.Y - boxHeight / 2)

    if Settings.ESPBox then
        esp.Box.Visible = true
        esp.Box.Position = boxPos
        esp.Box.Size = Vector2.new(boxWidth, boxHeight)
        esp.Box.Color = color
    else
        esp.Box.Visible = false
    end

    if Settings.ESPName then
        esp.Name.Visible = true
        esp.Name.Position = Vector2.new(headScreen.X, headScreen.Y - 25)
        esp.Name.Text = player.Name
    else
        esp.Name.Visible = false
    end

    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    if Settings.ESPDistance and localRoot then
        local distance = math.floor((rootPart.Position - localRoot.Position).Magnitude)
        esp.Distance.Visible = true
        esp.Distance.Position = Vector2.new(rootScreen.X, rootScreen.Y + 10)
        esp.Distance.Text = tostring(distance) .. " studni"
    else
        esp.Distance.Visible = false
    end

    if Settings.ESPLines then
        esp.Line.Visible = true
        esp.Line.From = Vector2.new(currentCamera.ViewportSize.X / 2, currentCamera.ViewportSize.Y)
        esp.Line.To = Vector2.new(rootScreen.X, rootScreen.Y)
        esp.Line.Color = color
    else
        esp.Line.Visible = false
    end
end

-- ===== GŁÓWNA PĘTLA =====
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera or Camera
    if not Camera then
        return
    end

    -- Aimbot
    if Settings.Aimbot and not menuVisible then
        local closest = nil
        local shortestDist = Settings.AimbotFOV

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local targetPart = character:FindFirstChild(Settings.AimbotPart)
                    or character:FindFirstChild("HumanoidRootPart")

                if humanoid and humanoid.Health > 0 and targetPart then
                    local sameTeam = player.Team ~= nil
                        and LocalPlayer.Team ~= nil
                        and player.Team == LocalPlayer.Team
                    if Settings.TeamCheck and sameTeam then
                        continue
                    end

                    if not isVisible(targetPart) then
                        continue
                    end

                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen and screenPos.Z > 0 then
                        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if distance < shortestDist then
                            shortestDist = distance
                            closest = targetPart
                        end
                    end
                end
            end
        end

        if closest then
            local lookAt = CFrame.lookAt(Camera.CFrame.Position, closest.Position)
            local smoothness = math.clamp(Settings.AimbotSmoothness, 0.01, 1)
            Camera.CFrame = Camera.CFrame:Lerp(lookAt, smoothness)
        end
    end

    -- ESP + dynamic hitbox setting updates
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            enlargeHitbox(player.Character)
        end
    end

    for _, esp in ipairs(ESPObjects) do
        updateESP(esp)
    end
end)

-- ===== INICJALIZACJA I SPRZĄTANIE =====
local function trackPlayer(player)
    if player == LocalPlayer then
        return
    end

    createESP(player)
    player.CharacterAdded:Connect(function(character)
        task.wait(0.1)
        if character.Parent then
            enlargeHitbox(character)
        end
    end)

    if player.Character then
        enlargeHitbox(player.Character)
    end
end

Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(removeESP)

for _, player in ipairs(Players:GetPlayers()) do
    trackPlayer(player)
end

